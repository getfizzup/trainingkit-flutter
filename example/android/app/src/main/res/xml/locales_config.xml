<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the app supports. Lets Android honor a per-app locale (set in
     MainActivity) so TrainingKit's native UI follows the app language. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fr" />
</locale-config>
